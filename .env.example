# Copy this file to .env (never commit .env) and fill in real values.

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me

# Firebase service account credentials as a single-line JSON string.
# Get it from: Firebase console > Project settings > Service accounts > Generate new private key
# Alternative for local dev: save the key file as fitness_app/unsw-college-website-firebase.json
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project-id"}